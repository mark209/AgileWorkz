# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3001

# --- Database ---
# Runtime role (app connections) — least privilege, see infra/sql/provision-roles.sql
DATABASE_URL="postgresql://app_runtime:CHANGE_ME@localhost:5432/agileworks_erp?schema=public"
# Migration role (deploy-time only, DDL rights) — never used by the running app
MIGRATE_DATABASE_URL="postgresql://app_migrator:CHANGE_ME@localhost:5432/agileworks_erp?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="CHANGE_ME_LONG_RANDOM_STRING"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING"
JWT_REFRESH_TTL="7d"

# --- Seed admin (Phase 1 bootstrap only) ---
SEED_ADMIN_EMAIL="owner@agileworks.example"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_ADMIN_NAME="AgileWorks Owner"

# --- Redis (BullMQ) ---
# Local dev: no credentials needed, the default docker-compose Redis has
# none. For any pilot/production deployment, REDIS_URL MUST include a
# real password (and use rediss:// for TLS, if your provider supports
# it) — Redis has no authentication at all otherwise. Never commit a real
# credential here; this file holds placeholders only.
#   redis://:PASSWORD@host:6379          (password-only auth)
#   redis://USERNAME:PASSWORD@host:6379  (Redis 6+ ACL auth)
#   rediss://USERNAME:PASSWORD@host:6380 (TLS)
# CONFIGURATION REQUIRED AT DEPLOYMENT — see
# docs/architecture/phase7-production-security-review.md (F-H1).
REDIS_URL="redis://localhost:6379"

# --- Object storage ---
# "local" is the day-to-day default (apps/api/src/common/storage/local-disk-storage.provider.ts).
# Set to "s3" only to exercise the MinIO/S3-compatible adapter (infra verification item J).
STORAGE_PROVIDER="local"          # local | s3
STORAGE_LOCAL_ROOT="./storage-local"
# S3-compatible (used only when STORAGE_PROVIDER=s3). Values below match the
# MinIO defaults in infra/docker-compose.yml — change them there and here together.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-southeast-1"
S3_BUCKET="agileworks-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# --- OCR/AI extraction ---
# "stub" is the default — no real extraction, no credentials required. See
# docs/architecture/ocr-worker-db-isolation.md.
# "vertex-gemini" is the approved Phase 5 Step 3 provider (Phase 5 Approved
# Baseline §04a). Decision 1 (model/region) is RESOLVED: gemini-2.5-flash in
# asia-southeast1, confirmed by the project owner directly in Google Cloud
# Model Garden — see §04a. This repo still has NO real Vertex AI credentials
# configured anywhere — do not set EXTRACTION_PROVIDER=vertex-gemini in a
# real .env until a real service account is provisioned (a separate,
# explicitly-approved step).
EXTRACTION_PROVIDER="stub"          # stub | vertex-gemini
# Required only when EXTRACTION_PROVIDER=vertex-gemini. VERTEX_AI_REGION
# must be a locational endpoint — "global" is rejected at boot
# (extraction-config.ts); never falls back to it automatically. Values below
# are the Decision-1-approved target, not yet activated.
VERTEX_AI_PROJECT_ID=""
VERTEX_AI_REGION="asia-southeast1"
VERTEX_AI_MODEL_ID="gemini-2.5-flash"
# Phase 5 Step 1 — the future extraction worker process (Step 3) connects
# using ONLY this credential, never DATABASE_URL. Grants: SELECT/INSERT/
# UPDATE on exactly the six extraction_* tables, nothing else in the schema
# — see infra/sql/provision-roles.sql and grant-runtime-privileges.sql.
OCR_WORKER_DATABASE_URL="postgresql://ocr_worker:changeme@localhost:5432/agileworks_erp?schema=public"

# --- CORS ---
WEB_APP_ORIGIN="http://localhost:3000"
FIELD_APP_ORIGIN="http://localhost:3002"

# --- Reverse proxy ---
# 0 (default) = trust nothing; correct for local dev and any deployment
# with NO reverse proxy directly in front of this app. Set to 1 for the
# expected pilot/production topology (exactly one reverse proxy/load
# balancer in front) — this is what makes the login rate limiter and
# every audit log's recorded IP correct instead of showing the proxy's
# own address for every request. Do NOT set this unless a real, single
# reverse proxy actually sits in front — a higher number, or setting this
# with no proxy present, lets a direct caller spoof req.ip by sending
# X-Forwarded-For themselves.
TRUST_PROXY_HOPS="0"
