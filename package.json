{
  "name": "agileworks-hvac-erp",
  "version": "0.1.0",
  "private": true,
  "description": "AgileWorks HVAC ERP — Phase 1 foundation (identity, RBAC, audit, system settings)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prisma:validate": "prisma validate --schema=./prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "dev:api": "pnpm --filter @agileworks/api start:dev",
    "dev:web": "pnpm --filter @agileworks/web dev",
    "dev:field": "pnpm --filter @agileworks/field dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
